<?xml version="1.0"?>
<robot name="classroom_humanoid">
  <!-- 骨盆：机器人根节点，基座位置即骨盆中心，站立时 z=0.74 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="7.0"/>
      <inertia ixx="0.06" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.20 0.18"/></geometry>
      <material name="pelvis"><color rgba="0.22 0.24 0.29 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.20 0.18"/></geometry>
    </collision>
  </link>

  <!-- 躯干 -->
  <joint name="torso_joint" type="fixed">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>
  <link name="torso_link">
    <inertial>
      <origin xyz="0 0 0.23" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.11" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.10"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.23" rpy="0 0 0"/>
      <geometry><box size="0.34 0.24 0.46"/></geometry>
      <material name="torso"><color rgba="0.86 0.88 0.92 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.23" rpy="0 0 0"/>
      <geometry><box size="0.34 0.24 0.46"/></geometry>
    </collision>
  </link>

  <!-- 头部 -->
  <joint name="head_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.46" rpy="0 0 0"/>
  </joint>
  <link name="head_link">
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><sphere radius="0.10"/></geometry>
      <material name="head"><color rgba="0.94 0.95 0.97 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><sphere radius="0.10"/></geometry>
    </collision>
  </link>

  <!-- 头部相机（仅视觉，实际成像由渲染器按该位姿计算） -->
  <joint name="camera_joint" type="fixed">
    <parent link="head_link"/>
    <child link="camera_link"/>
    <origin xyz="0.13 0 0.09" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.05 0.03"/></geometry>
      <material name="camera"><color rgba="0.08 0.08 0.10 1"/></material>
    </visual>
  </link>

  <!-- 2D 激光雷达：安装在骨盆上方 -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
      <material name="lidar"><color rgba="0.95 0.55 0.10 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
    </collision>
  </link>

  <!-- 左臂 -->
  <joint name="left_shoulder_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="left_upper_arm_link"/>
    <origin xyz="0.225 0 0.36" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="12" velocity="4.0"/>
  </joint>
  <link name="left_upper_arm_link">
    <inertial>
      <origin xyz="0 0 -0.13" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.13" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.26"/></geometry>
      <material name="arm"><color rgba="0.55 0.58 0.63 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.13" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.26"/></geometry>
    </collision>
  </link>
  <joint name="left_elbow_joint" type="revolute">
    <parent link="left_upper_arm_link"/>
    <child link="left_forearm_link"/>
    <origin xyz="0 0 -0.26" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="0.4" effort="10" velocity="4.0"/>
  </joint>
  <link name="left_forearm_link">
    <inertial>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><cylinder radius="0.038" length="0.24"/></geometry>
      <material name="arm"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><cylinder radius="0.042" length="0.24"/></geometry>
    </collision>
  </link>
  <joint name="left_hand_joint" type="fixed">
    <parent link="left_forearm_link"/>
    <child link="left_hand_link"/>
    <origin xyz="0 0 -0.24" rpy="0 0 0"/>
  </joint>
  <link name="left_hand_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="hand"><color rgba="0.80 0.72 0.66 1"/></material>
    </visual>
  </link>

  <!-- 右臂 -->
  <joint name="right_shoulder_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="right_upper_arm_link"/>
    <origin xyz="-0.225 0 0.36" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="12" velocity="4.0"/>
  </joint>
  <link name="right_upper_arm_link">
    <inertial>
      <origin xyz="0 0 -0.13" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.13" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.26"/></geometry>
      <material name="arm"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.13" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.26"/></geometry>
    </collision>
  </link>
  <joint name="right_elbow_joint" type="revolute">
    <parent link="right_upper_arm_link"/>
    <child link="right_forearm_link"/>
    <origin xyz="0 0 -0.26" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="0.4" effort="10" velocity="4.0"/>
  </joint>
  <link name="right_forearm_link">
    <inertial>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><cylinder radius="0.038" length="0.24"/></geometry>
      <material name="arm"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><cylinder radius="0.042" length="0.24"/></geometry>
    </collision>
  </link>
  <joint name="right_hand_joint" type="fixed">
    <parent link="right_forearm_link"/>
    <child link="right_hand_link"/>
    <origin xyz="0 0 -0.24" rpy="0 0 0"/>
  </joint>
  <link name="right_hand_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="hand"><color rgba="0.80 0.72 0.66 1"/></material>
    </visual>
  </link>

  <!-- 左腿 -->
  <joint name="left_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_thigh_link"/>
    <origin xyz="0.11 0 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9" upper="0.9" effort="45" velocity="5.0"/>
  </joint>
  <link name="left_thigh_link">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.13 0.14 0.30"/></geometry>
      <material name="leg"><color rgba="0.30 0.33 0.39 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.13 0.14 0.30"/></geometry>
    </collision>
  </link>
  <joint name="left_knee_joint" type="revolute">
    <parent link="left_thigh_link"/>
    <child link="left_shin_link"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="1.4" effort="55" velocity="5.0"/>
  </joint>
  <link name="left_shin_link">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.11 0.12 0.30"/></geometry>
      <material name="leg"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.11 0.12 0.30"/></geometry>
    </collision>
  </link>
  <joint name="left_ankle_joint" type="revolute">
    <parent link="left_shin_link"/>
    <child link="left_foot_link"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="0.7" effort="30" velocity="5.0"/>
  </joint>
  <link name="left_foot_link">
    <inertial>
      <origin xyz="0.05 0 -0.03" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 -0.03" rpy="0 0 0"/>
      <geometry><box size="0.24 0.11 0.06"/></geometry>
      <material name="foot"><color rgba="0.14 0.14 0.17 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.05 0 -0.03" rpy="0 0 0"/>
      <geometry><box size="0.24 0.11 0.06"/></geometry>
    </collision>
  </link>

  <!-- 右腿 -->
  <joint name="right_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_thigh_link"/>
    <origin xyz="-0.11 0 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9" upper="0.9" effort="45" velocity="5.0"/>
  </joint>
  <link name="right_thigh_link">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.13 0.14 0.30"/></geometry>
      <material name="leg"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.13 0.14 0.30"/></geometry>
    </collision>
  </link>
  <joint name="right_knee_joint" type="revolute">
    <parent link="right_thigh_link"/>
    <child link="right_shin_link"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="1.4" effort="55" velocity="5.0"/>
  </joint>
  <link name="right_shin_link">
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.11 0.12 0.30"/></geometry>
      <material name="leg"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><box size="0.11 0.12 0.30"/></geometry>
    </collision>
  </link>
  <joint name="right_ankle_joint" type="revolute">
    <parent link="right_shin_link"/>
    <child link="right_foot_link"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="0.7" effort="30" velocity="5.0"/>
  </joint>
  <link name="right_foot_link">
    <inertial>
      <origin xyz="0.05 0 -0.03" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 -0.03" rpy="0 0 0"/>
      <geometry><box size="0.24 0.11 0.06"/></geometry>
      <material name="foot"><color rgba="0.14 0.14 0.17 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.05 0 -0.03" rpy="0 0 0"/>
      <geometry><box size="0.24 0.11 0.06"/></geometry>
    </collision>
  </link>
</robot>
