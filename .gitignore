# 课程视频（体积过大，不入库）
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.webm

# 超过 GitHub 单文件 100MB 限制的模型权重
App/yolov8x-pose-p6.pt

# Python 缓存
__pycache__/
*.pyc

# 运行时数据库与生成的报告
App/sqlite3db/*.db
App/report/*.pdf
App/uploads/*
App/result/*
!App/uploads/.gitkeep
!App/result/.gitkeep
!App/report/.gitkeep

# 备份、日志与本地环境变量
*.bak.*
*.log
.env
